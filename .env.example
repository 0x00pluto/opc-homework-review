# Gemini API（当前 Agent 为 Mock，可不填）
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Turso（Vercel 集成 Turso 时会自动注入）
TURSO_DATABASE_URL="libsql://your-db-name-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# 本地开发可用嵌入式 libSQL（无需 Token）：
# TURSO_DATABASE_URL="file:./db_data/opc_homework.db"

# Vercel Blob 附件存储
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# Vercel Cron 鉴权（与控制台 CRON_SECRET 一致）
CRON_SECRET="your-random-cron-secret"
